= content_for :title do
  Role Based Access Control

%div{class: modal? ? 'modal-body' : ''}
  - if current_user.is_allowed?("networking:rbac_policy_create",{tenant_id:@scoped_project_id, network: @network})
    .toolbar.toolbar-controlcenter
      = render partial: 'networking/networks/access/new_rbac_form', locals: { auth_projects: @auth_projects }

  #rbacs-container
    - if @rbacs.length == 0
      %p#rbacs-empty No Access given to other projects
    - else
      = render partial: 'rbacs_table', locals: { rbacs: @rbacs, network: @network }


%div.buttons{class: modal? ? 'modal-footer' : ''}
  - if modal?
    %button.btn.btn-secondary{type:"button", data: {bs_dismiss:"modal"}, aria: {label: "Close"}} Close
  - else
    = link_to "Close", plugin('networking').send("networks_#{@network_type}_index_url"), class: 'btn btn-secondary'
