<% if @rbac.errors.empty? %>
  $('#new_rbac_form .alert-error').empty().addClass('hidden');
  var rowHtml="<%= j(render(partial: 'networking/networks/access/rbac_item', locals:{rbac: @rbac, network: @network})) %>"

  if($("table#rbacs tbody").length == 1) {
    // Table already present: prepend the new row.
    $("table#rbacs tbody").prepend(rowHtml);
  } else {
    // List was empty (only the "No Access" message was shown): replace the
    // whole container with the table so it becomes visible.
    var tableHtml="<%= j(render(partial: 'networking/networks/access/rbacs_table', locals:{rbacs: [@rbac], network: @network})) %>"
    $("#rbacs-container").html(tableHtml);
  }

  $('[data-control-rbac-form]').rbacFormControl('hide');
<% else %>
  $('#new_rbac_form .alert-error').html('<%=@rbac.errors.full_messages.to_sentence%>').removeClass('hidden');
<% end %>
