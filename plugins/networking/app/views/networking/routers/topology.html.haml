/ = content_for :title do
/   Show

.modal-body.networking
  #graph

/ Load D3 v3 from vendor directory since it requires global context
%script{src: asset_path("d3.v3.min.js")}
:javascript
  // Wait for D3, networking.Topology, AND for the #graph container to have a
  // real width (the modal animates in, so an early measurement would be 0 and
  // the graph would fall back to a narrow fixed width).
  (function initTopology() {
    var ready = typeof window.d3 !== 'undefined' && window.networking && window.networking.Topology;
    var container = document.querySelector('#graph');
    var hasWidth = container && container.offsetWidth > 0;
    if (ready && hasWidth) {
      try {
        new networking.Topology("#graph",#{sanitize(@topology_graph.to_json)}, {details_url: "#{plugin('networking').router_node_details_path(@router.id)}"});
      } catch(e) {
        console.log('Error in Topology',e)
      }
    } else {
      setTimeout(initTopology, 50);
    }
  })();

- if modal?
  .modal-footer
    - if modal?
      %button.btn.btn-secondary{type:"button", data: {bs_dismiss:"modal"}, aria: {label: "Close"}} Close
    - else
      = link_to "Close", networks_url(), class: 'btn btn-secondary'
