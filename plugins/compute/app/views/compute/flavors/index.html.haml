= content_for :main_toolbar do
  Flavors


.switcher-banner.switcher-border-gradient.margin-bottom
  .switcher-banner__icon
    %svg{xmlns: "http://www.w3.org/2000/svg", height: "40", width: "40", viewBox: "0 -960 960 960", "aria-hidden": "true"}
      %defs
        %linearGradient{id: "rocketGradient", x1: "0%", y1: "0%", x2: "100%", y2: "100%"}
          %stop{offset: "0%", style: "stop-color:#6637cd"}
          %stop{offset: "100%", style: "stop-color:#b8149d"}
      %path{fill: "url(#rocketGradient)", d: "m98-537 168-168q14-14 33-20t39-2l52 11q-54 64-85 116t-60 126L98-537Zm205 91q23-72 62.5-136T461-702q88-88 201-131.5T873-860q17 98-26 211T716-448q-55 55-120 95.5T459-289L303-446Zm332.5-97q33.5 0 56.5-23t23-56.5q0-33.5-23-56.5t-56.5-23q-33.5 0-56.5 23t-23 56.5q0 33.5 23 56.5t56.5 23ZM551-85l-64-147q74-29 126.5-60T730-377l10 52q4 20-2 39.5T718-252L551-85ZM162-318q35-35 85-35.5t85 34.5q35 35 35 85t-35 85q-25 25-83.5 43T87-74q14-103 32-161t43-83Z"}
  .switcher-banner__text
    %span.switcher-banner__title Preview Flavors in Aurora
    %span.switcher-banner__body The Flavors feature is available as an early access preview in Aurora, our all-new dashboard. While it may not be finished and complete, you're invited to have a look and let us know what you think!
  .switcher-banner__button-wrap
    %a.switcher-btn{href: "https://dashboard-aurora.#{current_region}.cloud.sap/projects/#{@scoped_project_id}/compute/flavors", onclick: track_outbound_navigation_js("compute_flavors_banner"), data: {turbo: false}}
      Have a Peek
  %p= " "   


- if current_user.is_allowed?("compute:flavor_create", {target: {scoped_domain_name: @scoped_domain_name, user_id: current_user.id}})
  .toolbar
    .main-buttons
      = link_to 'Create new', plugin('compute').new_flavor_path, data: {modal: true}, class: 'btn btn-primary'

= @pagination_enable
%table.table.flavors{ "data-sortable-columns" => "1:string,2:number,3!:number,4:number"}
  %thead
    %tr
      %th Name
      %th VCPUs
      %th RAM
      %th Root Disk
      %th Ephemeral Disk
      %th Swap Disk
      %th RX/TX factor
      %th Public
      %th
  %tbody#flavors
    - if @flavors.length==0
      %tr{data: {empty: true}}
        %td{colspa: 9} No flavors available.

    - else
      - @flavors.each do |flavor|
        = render partial: 'item', locals: {flavor: flavor}

= render_paginatable(@flavors)
