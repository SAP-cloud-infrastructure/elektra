%html.compute-njq
  %head
    %meta(http-equiv="X-UA-Compatible" content="IE=edge")
    %meta(name="viewport" content="width=device-width, initial-scale=1")
    %title= "Console for #{@instance && (@instance[:name] || @instance[:id])}"
    = stylesheet_link_tag "application", media: "all"
    = render "layouts/favicon"
    = csrf_meta_tags
    :css
      html, body.compute-njq-console-page-body { height: 100%; margin: 0; }
      body.compute-njq-console-page-body {
        display: flex; flex-direction: column;
        background: #222; color: #fff;
        /* The global theme adds body padding-top to clear the fixed navbar; this
           chrome-less page has no navbar, so drop it. */
        padding-top: 0 !important;
      }
      .compute-njq-console-toolbar {
        display: flex; align-items: center; gap: 1rem;
        padding: 0.4rem 0.75rem; background: #1a1a1a; border-bottom: 1px solid #000;
      }
      .compute-njq-console-title { font-weight: 600; }
      .compute-njq-console-hint {
        flex: 1; min-width: 0; font-size: 0.8rem; opacity: 0.7;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .compute-njq-console-buttons { white-space: nowrap; }
      .compute-njq-console-body { position: relative; flex: 1; min-height: 0; }
      .compute-njq-console-state {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        height: 100%; padding: 1rem;
      }
      .compute-njq-console-frame { width: 100%; height: 100%; border: none; background: #000; }
  %body.compute-njq-console-page-body
    .compute-njq-console-toolbar
      %span.compute-njq-console-title
        %i.fa.fa-terminal.me-2
        = "Web Console — #{@instance && (@instance[:name] || @instance[:id])}"
      %span.compute-njq-console-hint
        Click the console area to focus it. The session may expire — click Reload if the connection is lost.
      %span.compute-njq-console-buttons
        - if current_user.is_allowed?("compute_njq:instance_hard_reset", { target: { project: @active_project, scoped_domain_name: @scoped_domain_name } })
          %button.btn.btn-sm.btn-danger.me-2{ type: "button", data: { hard_reset_url: "#{plugin('compute_njq').start_path.chomp('/')}/api/instances/#{@instance && @instance[:id]}/action", instance_name: (@instance && (@instance[:name] || @instance[:id])) } }
            %i.fa.fa-bolt.me-1
            Hard Reset
        = link_to "javascript:location.reload();", class: "btn btn-sm btn-secondary me-2" do
          %i.fa.fa-rotate-right.me-1
          Reload
        = link_to "Close", "javascript:window.close();", class: "btn btn-sm btn-secondary"
    .compute-njq-console-body
      = yield

    :javascript
      (function () {
        var btn = document.querySelector("[data-hard-reset-url]");
        if (!btn) return;
        var token = (document.querySelector("meta[name=csrf-token]") || {}).content;
        btn.addEventListener("click", function () {
          var name = btn.getAttribute("data-instance-name");
          if (!window.confirm("Hard reset “" + name + "”? This forcibly power-cycles the instance without a clean shutdown. Unsaved data may be lost.")) return;
          btn.disabled = true;
          fetch(btn.getAttribute("data-hard-reset-url"), {
            method: "POST",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json", "X-CSRF-Token": token },
            body: JSON.stringify({ action_name: "hard_reset" })
          }).then(function (r) {
            if (!r.ok) throw new Error("Hard reset failed (" + r.status + ")");
          }).catch(function (e) {
            window.alert(e.message);
          }).finally(function () {
            btn.disabled = false;
          });
        });
      })();
