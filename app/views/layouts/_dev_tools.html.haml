%ul.footer-nav
  %li
    = link_to 'Debug info', '#', data: { bs_toggle: "modal", bs_target: "#debug" } if current_user

    .modal.fade#debug
      .modal-dialog.modal-lg
        .modal-content
          .modal-header
            %h4.modal-title Debug Info
            %button.btn-close{type: "button", data: {bs_dismiss: "modal"}, aria: {label: "Close"}}
          .modal-body
            - if plugin_name
              %pre< Plugin Name: #{plugin_name}
            %pre< Current region: #{current_region}
            %pre<= JSON.pretty_generate(current_user.context) if current_user
          .modal-footer
            = link_to 'Close', '#', data: {bs_dismiss: "modal"}, class: "btn"
