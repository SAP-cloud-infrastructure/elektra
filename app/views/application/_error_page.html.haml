- header_title ||= "Application"
- title ||= "An error has occurred"
- description ||= "Something went wrong while processing your request.<br> Please try later again."
- token ||= nil
- details ||= nil


- if modal?
  = content_for :title do
    %span{class: "#{plugin_name}-icon error-icon"}
    %span.active
      = "#{header_title} Error"

  .modal-body

    %h3
      = title.html_safe

    .alert.alert-error.alert-extended
      .alert-body
        = description.html_safe
      - unless token.nil?
        %hr
        .alert-footer
          %b Error ID:
          %span
            = token


  - if modal?
    .modal-footer
      %button.btn.btn-secondary{type:"button", data: {dismiss:"modal"}, aria: {label: "Close"}} Close

- else

  %h3
    = title.html_safe

  .alert.alert-error.alert-extended
    .alert-body
      = description.html_safe
    - unless token.nil?
      %hr
      .alert-footer
        %b Error ID:
        %span
          = token
